# Postgres connection (Vercel Postgres / Neon at runtime; a local Postgres for dev).
# On Vercel the Neon integration marks this "Sensitive" so `vercel env pull` returns it
# EMPTY — the real value only exists at runtime. Run migrate/seed via the /api/setup route.
DATABASE_URL=postgres://user:pass@localhost:5432/mkv2_dryrun3

# Shared secret guarding POST /api/setup (one-shot migrate+seed from the deployed function).
# Generate with: openssl rand -hex 24
SETUP_TOKEN=change-me
